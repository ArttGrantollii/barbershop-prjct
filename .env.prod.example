POSTGRES_USER=vendos
POSTGRES_PASSWORD=
POSTGRES_DB=vendos_salon

# REQUIRED. Generate a strong unique value before deploying.
SECRET_KEY=

# Production browser origin(s), comma-separated.
ALLOWED_ORIGINS=https://your-domain.example

# IANA timezone for the salon's physical location.
SALON_TIMEZONE=UTC

# Optional first admin seed. Prefer rotating/removing after first deploy.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

NOTIFICATIONS_BACKEND=console

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=
AWS_SNS_SENDER_ID=VendosSalon

# Frontend build-time API URL for docker-compose.prod.yml.
VITE_API_URL=https://api.your-domain.example
