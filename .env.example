POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vendos_salon

# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: seed an admin account on first startup. Leave blank to skip.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# IANA timezone for the salon's physical location (e.g. America/New_York, Europe/London)
SALON_TIMEZONE=UTC

NOTIFICATIONS_BACKEND=console

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=
AWS_SNS_SENDER_ID=VendosSalon

ALLOWED_ORIGINS=http://localhost:3000
